# Copy to .env and adjust. Only DOCKHAND_SECRET and POSTGRES_PASSWORD must change.

# Port Dockhand is published on (http://localhost:5773).
DOCKHAND_PORT=5773
# Optional dedicated MCP port. Leave empty to serve MCP at <public url>/mcp on DOCKHAND_PORT
# (one port to open). If set, also publish it in docker-compose.yml.
DOCKHAND_MCP_PORT=
# Public URL used for webhook and MCP URLs. Set to your real https URL behind a proxy.
DOCKHAND_PUBLIC_URL=http://localhost:5773
# Encrypts host passwords, git tokens and webhook secrets at rest. Generate with: openssl rand -hex 32
DOCKHAND_SECRET=change-me-to-a-long-random-string
# Register the machine Dockhand runs on (via /var/run/docker.sock) as a host on first boot.
DOCKHAND_AUTO_LOCAL=true

POSTGRES_USER=dockhand
POSTGRES_PASSWORD=dockhand
POSTGRES_DB=dockhand

# Optional GitHub integrations (PAT connections work without these).
# OAuth device flow: create an OAuth app with "Enable Device Flow" checked.
GITHUB_OAUTH_CLIENT_ID=
# GitHub App: set the app id, its slug and the private key (PEM, \n-escaped or via _FILE).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
